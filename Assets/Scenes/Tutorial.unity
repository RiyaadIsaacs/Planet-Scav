    messageText: {fileID: 1449913374}
    title: Movement
    message: 'Use WASD to move around.

      Hold Left Shift to sprint.'
  - canvas: {fileID: 1058648251}
    titleText: {fileID: 1226584613}
    messageText: {fileID: 2067363925}
    title: Camera
    message: Move the mouse to look around and explore.
  - canvas: {fileID: 491121241}
    titleText: {fileID: 384818822}
    messageText: {fileID: 223305272}
    title: Jumping
    message: 'Press Space to jump.

      Hold Ctrl and press Space to charge a higher
      jump.'
  - canvas: {fileID: 1261048361}
    titleText: {fileID: 223995998}
    messageText: {fileID: 445531995}
    title: Interact
    message: 'Press E to interact with objects when you are nearby.

      Try it
      on the glowing terminal ahead.'
  - canvas: {fileID: 684779193}
    titleText: {fileID: 2088348445}
    messageText: {fileID: 455187519}
    title: Ready to Go
    message: Great work! Walk through the green exit ahead to begin your mission
