$[1]=D[j];return N[0]}function z(D,j){return D[j]<<24|D[j+1]<<16|D[j+2]<<8|D[j+3]}function o(D,j,y){var F="";
for(var J=0;J<y;J++)F+=String.fromCharCode(D[j+J]);return F}function V(D,j,y){var F=[];for(var J=0;J<y;
