	UZIP["adler"  ] = adler;
	
	UZIP["inflate"   ] = inflate;
	UZIP["inflateRaw"] = inflateRaw;
	UZIP["deflate"   ] = deflate;
	UZIP["deflateRaw"] = deflateRaw;
	UZIP["parse"     ] = parse;
	UZIP["encode"    ] = encode;
})();







(function() {
	
