		- decompressed block can have bytes, which do not occur in a Huffman tree (copied from the previous block by reference)
	*/

	function getTrees() {
		var ML = _hufTree(U.lhst, U.ltree, 15);
		var MD = _hufTree(U.dhst, U.dtree, 15);
