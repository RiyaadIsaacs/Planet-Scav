.dialogue-container {
    width: 80%;
    max-width: 820px;
    height: auto;
    background-color: rgba(0, 0, 0, 0.88);
    border-radius: 15px;
    padding: 25px;
    flex-direction: column;
    align-items: center;
    position: absolute;
    bottom: 50px;
    left: 50%;
    translate: -50% 0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.6);
}

.header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 20px;
}

.icon {
    width: 90px;
    height: 90px;
    margin-right: 20px;
    flex-shrink: 0;
}

.alert-name {
    font-size: 32px;
    color: #ffffff;
    -unity-font-style: bold;
}

.message {
    font-size: 24px;
    color: #f0f0f0;
    text-align: center;
    margin-bottom: 25px;
    white-space: normal;
    flex-wrap: wrap;
}

.next-button {
    background-color: #ffcc00;
    color: #1a1a1a;
    font-size: 26px;
    padding: 12px 40px;
    border-radius: 10px;
    margin-top: 10px;
}