<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Dialogue/DialogueStyle.uss?fileID=7433441132597879392&amp;guid=45ee96dbe1e23a44a94508064053d01e&amp;type=3#DialogueStyle" />
    <ui:VisualElement name="dialogue-container" style="flex-grow: 1;">
        <ui:VisualElement name="header" style="flex-grow: 1; align-self: center; justify-content: center; flex-direction: column; align-items: auto;">
            <ui:VisualElement name="Icon" style="flex-grow: 1; background-image: none; width: 48px;" />
            <ui:Label text="Label" name="alert-name" />
        </ui:VisualElement>
        <ui:Label text="Label" name="message" style="width: 1064px; white-space: pre; text-overflow: clip; border-top-width: 0; border-bottom-width: 0; border-right-width: 0;" />
    </ui:VisualElement>
    <ui:Button text="Next" name="next-button" style="width: 220px; -unity-text-align: lower-center; white-space: pre; text-overflow: ellipsis; translate: 0 0; transform-origin: bottom;" />
</ui:UXML>
