/* CHARGE BAR */

/* Container for Pump*/
.hud-container {
    position: absolute;
    top: 50px;
    left: 50px;
    flex-direction: column;
    gap: 12px;
    z-index: 100;
}

.charge-container {
    flex-direction: column;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 18px 16px;
    border-radius: 16px;
    border: 3px solid #ffcc00;
    gap: 12px;
}

/* Label for pump*/
.charge-label {
    color: #ffcc00;
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.charge-background {
    width: 38px;           
    height: 280px;         
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 19px;
    overflow: hidden;
    border: 3px solid #555;
}

.charge-fill {
    width: 100%;
    height: 0%;                    
    background-color: #ffcc00;
    border-radius: 16px;
    transition: height 0.15s ease-out;
    align-self: flex-end;          
}

/* Colour change based on charge */
.charge-fill.high  { background-color: #ff5555; }
.charge-fill.medium { background-color: #ffcc00; }
.charge-fill.low   { background-color: #44ff88; }

/* Label for pump value*/
.charge-value {
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    margin-top: 6px;
}

/* Dialogue Box */
.dialogue-container {
    width: 80%;
    max-width: 900px;
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 16px;
    padding: 25px;
    flex-direction: column;
    align-items: center;
    position: absolute;
    bottom: 60px;
    left: 50%;
    translate: -50% 0;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);
}

/* header with icon */
.header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 20px;
    gap: 20px;
}

.icon {
    width: 110px;
    height: 110px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center center;
    border-radius: 14px;
    border: 4px solid #ffcc00;
}

/* Text */
.alert-name {
    font-size: 34px;
    color: #ffffff;
    -unity-font-style: bold;
    flex-grow: 1;
}

.message {
    font-size: 26px;
    color: #eeeeee;
    text-align: center;
    margin-bottom: 25px;
    white-space: normal;
    line-height: 1.4;
    padding: 0 20px;
}

/* Next button */
.next-button {
    background-color: #ffcc00;
    color: #1a1a1a;
    font-size: 26px;
    font-weight: bold;
    padding: 14px 50px;
    border-radius: 12px;
    min-width: 180px;
    align-self: center;
    transition: all 0.2s ease;
}

.next-button:hover {
    background-color: #ffd633;
    scale: 1.05;
}

/* Dialogue hidden */
.dialogue-container[display="none"] {
    display: none;
}