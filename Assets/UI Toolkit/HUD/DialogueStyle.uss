/* Container for Pump*/
.hud-container {
    position: absolute;
    top: 40px;
    left: 40px;
    flex-direction: column;
    gap: 10px;
    z-index: 100;
}

.charge-container {
    background-color: rgba(0, 0, 0, 0.65);
    padding: 16px 22px;
    border-radius: 14px;
    border: 3px solid #ffcc00;
    min-width: 360px;
    flex-direction: column;
    gap: 10px;
}
/* Label for pump*/
.charge-label {
    color: #ffcc00;
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.charge-background {
    width: 320px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid #666;
}

.charge-fill {
    height: 100%;
    background-color: #ffcc00;
    border-radius: 14px;
    transition: width 0.15s ease-out;
}
/* Label for pump value*/
.charge-value {
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
    align-self: center;
}

/* Color fill*/
.charge-fill.high {
    background-color: #ff5555;
}

.charge-fill.medium {
    background-color: #ffcc00;
}

.charge-fill.low {
    background-color: #44ff88;
}

/* Dialogue Box */
.dialogue-container {
    width: 80%;
    max-width: 900px;
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 16px;
    padding: 25px;
    flex-direction: column;
    align-items: center;
    position: absolute;
    bottom: 60px;
    left: 50%;
    translate: -50% 0;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);
}

/* header with icon */
.header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 20px;
    gap: 20px;
}

.icon {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 12px;
    border: 3px solid #ffcc00;
}

/* Text */
.alert-name {
    font-size: 34px;
    color: #ffffff;
    -unity-font-style: bold;
    flex-grow: 1;
}

.message {
    font-size: 26px;
    color: #eeeeee;
    text-align: center;
    margin-bottom: 25px;
    white-space: normal;
    line-height: 1.4;
    padding: 0 20px;
}

/* Next button */
.next-button {
    background-color: #ffcc00;
    color: #1a1a1a;
    font-size: 26px;
    font-weight: bold;
    padding: 14px 50px;
    border-radius: 12px;
    min-width: 180px;
    align-self: center;
    transition: all 0.2s ease;
}

.next-button:hover {
    background-color: #ffd633;
    scale: 1.05;
}

/* Dialogue hidden */
.dialogue-container[display="none"] {
    display: none;
}